{
  "opencollection": "1.0.0",
  "info": {
    "name": "MotionElements Marketplace Account Media types API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Media types",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List media types",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.motionelements.com/v2/media-types",
            "params": [
              {
                "name": "language",
                "value": "",
                "type": "query",
                "description": "ISO 639-1 language code (lowercase) for returned data: en, ja, ko, zh-hant."
              },
              {
                "name": "currency",
                "value": "",
                "type": "query",
                "description": "ISO 4217 currency code (uppercase) for pricing: USD, EUR, JPY, KRW, TWD."
              }
            ]
          },
          "docs": "List all supported media types and their sub-media-types."
        },
        {
          "info": {
            "name": "List media type categories",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.motionelements.com/v2/media-types/:mediaType/categories",
            "params": [
              {
                "name": "mediaType",
                "value": "",
                "type": "path",
                "description": "Media type code (e.g. video, music, sfx, photo)."
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Category type filter (e.g. style)."
              },
